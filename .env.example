# Ambiente: development | production
NODE_ENV=development

# Servidor HTTP
PORT=3000

# CORS: origem permitida (ex.: http://localhost:5173) ou * para qualquer origem
CORS_ORIGIN=*

# Chave secreta para JWT (defina um valor forte em produção)
JWT_SECRET=

# Google Maps JavaScript API — rota /api/config/google-maps-key (mapa no site)
GOOGLE_MAPS_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nimu_pwa_db
DB_USER=postgres
DB_PASSWORD=
# true para conexões que exigem SSL (ex.: provedores em nuvem)
DB_SSL=false
# Schema das tabelas FitPoint
DB_SCHEMA=fitpoint

# Credenciais do admin inicial (script scripts/migrate.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=0aYC5V6R083WxfPerMhVhlHm

# URL pública do site (webhooks de pagamento)
APP_URL=http://localhost:3000

# Mercado Pago (checkout transparente — Pix + cartão dentro do site)
MP_ACCESS_TOKEN=
# Chave pública (Public Key) — usada no navegador para tokenizar o cartão.
# Painel MP: Suas integrações > Credenciais de produção > Public Key
MP_PUBLIC_KEY=
# Opcional: segredo para validar notificações
MP_WEBHOOK_SECRET=

# Resend (e-mail dos ingressos / campanhas)
RESEND_API_KEY=
# Remetente verificado no domínio próprio (evite onboarding@resend.dev em produção)
RESEND_FROM=FitPoint <onboarding@resend.dev>
# Opcional: endereço de resposta (padrão = e-mail de RESEND_FROM, se não for resend.dev)
RESEND_REPLY_TO=
# Opcional: segredo dos links de descadastro (padrão = JWT_SECRET)
RESEND_UNSUBSCRIBE_SECRET=

# WhatsApp Cloud API (Meta) — reativação de clientes ausentes
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=reativacao_ausente
WHATSAPP_TEMPLATE_LANG=pt_BR
